# Valores solo para la demostración local enlazada a 127.0.0.1.
APP_SECRET=local-only-change-this-secret-before-use-2026
SCIM_TOKEN=local-only-change-this-scim-token-before-use-2026
OIDC_CLIENT_ID=identity-access-app
OIDC_CLIENT_SECRET=local-only-oidc-client-secret-2026
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-only-keycloak-admin-password-2026
DEMO_PASSWORD_ENGINEER=Lab-Engineer-Only-2026!
DEMO_PASSWORD_AUDITOR=Lab-Auditor-Only-2026!
DEMO_PASSWORD_ADMIN=Lab-Admin-Only-2026!
DEMO_PASSWORD_RRHH=Lab-RRHH-Only-2026!
DEMO_PASSWORD_TI=Lab-TI-Only-2026!
DEMO_PASSWORD_IAM=Lab-IAM-Only-2026!
DEMO_PASSWORD_SOC_AUDITORIA=Lab-SOC-Audit-Only-2026!
DEMO_PASSWORD_SEGURIDAD_FISICA=Lab-Physical-Security-Only-2026!

# --- Acceso con badge NFC (opcional) ---
# Poner NFC_ENABLED=true y arrancar tools/nfc-bridge.ps1 en el host con el mismo token.
NFC_ENABLED=true
NFC_BRIDGE_TOKEN=local-only-change-this-nfc-bridge-token-2026
# Usuario y contraseña que la app usa al abrir sesión por badge.
# Si NFC_LOGIN_PASSWORD se deja vacío se reutiliza DEMO_PASSWORD_ADMIN.
NFC_LOGIN_PASSWORD=
# Segundos que un toque espera a que el navegador lo consuma.
NFC_TAP_TTL_SECONDS=15

# --- NVR Frigate & Cámaras Móviles Android ---
FRIGATE_VERSION=0.14.1
TZ=America/Mexico_City

# Credenciales de las aplicaciones de cámara en los celulares Android (IP Webcam / RTSP Camera Server)
FRIGATE_CAM_USER=admin
FRIGATE_CAM_PASS=admin

# IPs locales asignadas a los dispositivos Android en la red Wi-Fi
FRIGATE_CAM_ENTRADA_IP=192.168.1.101
FRIGATE_CAM_INTERIOR_IP=192.168.1.102
FRIGATE_CAM_PORT=8080

# Despliegue en red local
APP_BASE_URL=http://localhost:8000
KC_HOSTNAME=http://localhost:8081
FRIGATE_CAM_USER=usuario_camara
FRIGATE_CAM_PASS=cambia_esta_clave
FRIGATE_CAM_ENTRADA_IP=IP_DEL_CELULAR
FRIGATE_CAM_PORT=8080


